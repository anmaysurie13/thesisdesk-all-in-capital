# ThesisDesk — All In Capital
# Copy to .env.local and fill in. Never commit .env.local. Never paste keys into chat.

# --- Environment ---------------------------------------------------------
APP_ENV=test                 # test | live  (live needs explicit authorisation)
DATA_MODE=case_study         # case_study = MESA/synthetic data only; real founder data is refused until consent terms are in place
EMAIL_MODE=simulate          # simulate | test (allow-list only) | live
EMAIL_TEST_ALLOWLIST=        # comma-separated addresses allowed in EMAIL_MODE=test
APP_URL=

# --- Neon Postgres -------------------------------------------------------
DATABASE_URL=                # main branch (live)
DATABASE_URL_TEST=           # separate Neon branch for tests, evals and volume runs

# --- Auth.js (generated locally, do not reuse) ---------------------------
AUTH_SECRET=
WORKER_SECRET=               # Bearer token for /api/worker/tick
CRON_SECRET=                 # Vercel Schedules / GitHub Actions trigger
EVAL_TOKEN=                 # harness token, honoured only when APP_ENV=test

# --- AI: Gemini models via OpenRouter, routed through Portkey -------------
# Path: app -> Portkey (retries, logs) -> OpenRouter -> Google Gemini
# NOTE: every google/gemini-* model on OpenRouter is PAID per token (no :free Gemini variants as of 24 Nov 2026).
OPENROUTER_API_KEY=
PORTKEY_API_KEY=
PORTKEY_PROVIDER=openrouter            # x-portkey-provider header; the OpenRouter key is passed through as the Authorization header
GEMINI_MODEL_PRIMARY=google/gemini-3.8-flash     # scoring, briefs, email drafts
GEMINI_MODEL_FAST=google/gemini-3.1-flash-lite   # extraction, reply classification
GEMINI_MODEL_JUDGE=google/gemini-3.6-flash       # separate judge config for soft eval assertions
OPENROUTER_DATA_COLLECTION=deny        # route only to providers that don't train on / retain prompts
# Hard spend guards (USD). The worker pauses when either is reached; no fallback to other models.
DAILY_SPEND_CAP_USD=1.00
MONTHLY_SPEND_CAP_USD=15.00
DAILY_MODEL_CALL_CAP=800

# --- Langfuse ------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU default; LANGFUSE_HOST also accepted

# --- Tavily --------------------------------------------------------------
TAVILY_API_KEY=
TAVILY_MONTHLY_CREDIT_CAP=900
TAVILY_CREDITS_PER_APPLICATION=4

# --- Resend --------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=                 # e.g. Riya <riya@your-verified-domain>
RESEND_INBOUND_ADDRESS=      # <id>.resend.app address or replies@your-domain
RESEND_WEBHOOK_SECRET=       # whsec_… from the Resend webhook settings

# --- Calendly ------------------------------------------------------------
CALENDLY_PAT=
CALENDLY_EVENT_TYPE_URI=     # https://api.calendly.com/event_types/…
CALENDLY_SCHEDULING_URL=     # public 30-min link
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Outreach rules ------------------------------------------------------
FOLLOWUP_DAYS=3,7
FOLLOWUP_MAX=2
